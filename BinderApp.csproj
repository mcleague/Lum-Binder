<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyTitle>Lum Binder</AssemblyTitle>
    <AssemblyName>Lum Binder</AssemblyName>
    <Product>Lum Binder</Product>
    <Version>1.0.2</Version>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">REPLACE_WITH_GITHUB_OWNER/REPOSITORY</UpdateRepository>
    <WorkshopApiUrl Condition="'$(WorkshopApiUrl)' == ''">REPLACE_WITH_WORKER_URL</WorkshopApiUrl>
    <WorkshopAdminBuild Condition="'$(WorkshopAdminBuild)' == ''">false</WorkshopAdminBuild>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\300px-Кот-Базилио.webp" />
    <Content Include="Assets\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepository</_Parameter1>
      <_Parameter2>$(UpdateRepository)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WorkshopApiUrl</_Parameter1>
      <_Parameter2>$(WorkshopApiUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WorkshopAdminBuild</_Parameter1>
      <_Parameter2>$(WorkshopAdminBuild)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
