<Window x:Class="BinderApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BinderApp.Controls"
        Title="Lum Binder"
        Width="960" Height="620"
        MinWidth="760" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Lum Binder"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextLightBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,24,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="Бинды"
                                     GroupName="NavModeGroup"
                                     IsChecked="{Binding IsBindsView, Mode=OneWay}"
                                     Command="{Binding SwitchViewModeCommand}"
                                     CommandParameter="0"
                                     Style="{StaticResource TabStripItemStyle}"/>
                        <RadioButton Content="Переменные профиля"
                                     GroupName="NavModeGroup"
                                     IsChecked="{Binding IsVariablesView, Mode=OneWay}"
                                     Command="{Binding SwitchViewModeCommand}"
                                     CommandParameter="1"
                                     Margin="4,0,0,0"
                                     Style="{StaticResource TabStripItemStyle}"/>
                        <RadioButton Content="Блокнот"
                                     GroupName="NavModeGroup"
                                     IsChecked="{Binding IsNotepadView, Mode=OneWay}"
                                     Command="{Binding SwitchViewModeCommand}"
                                     CommandParameter="2"
                                     Margin="4,0,0,0"
                                     Style="{StaticResource TabStripItemStyle}"/>
                        <RadioButton Content="Прочее"
                                     GroupName="NavModeGroup"
                                     IsChecked="{Binding IsDescriptionView, Mode=OneWay}"
                                     Command="{Binding SwitchViewModeCommand}"
                                     CommandParameter="3"
                                     Margin="4,0,0,0"
                                     Style="{StaticResource TabStripItemStyle}"/>
                        <RadioButton Content="Настройки"
                                     GroupName="NavModeGroup"
                                     IsChecked="{Binding IsSettingsView, Mode=OneWay}"
                                     Command="{Binding SwitchViewModeCommand}"
                                     CommandParameter="4"
                                     Margin="4,0,0,0"
                                     Style="{StaticResource TabStripItemStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Content="—"
                                Style="{StaticResource IconButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Свернуть"
                                Margin="0,0,4,0"/>
                        <Button Content="×"
                                Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Свернуть в трей"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsBindsView, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:TabStrip Grid.Column="0" DataContext="{Binding}"/>
                            <Border Grid.Column="1"
                                    Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="30"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="8,4"
                                             Width="150"
                                             FontSize="12"/>
                                    <TextBlock Text="Поиск..."
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="9,6,0,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchFilter}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredBinds}"
                             SelectedItem="{Binding SelectedBind, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="14,12,14,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ListBox_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder"
                                                    Background="{StaticResource PanelBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource PanelHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              Margin="2,0,12,0"
                                              Click="BindCheckBox_Click"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextLightBrush}"/>
                                        <TextBlock Text="{Binding StepsCount, StringFormat='{}Шагов: {0}'}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Background="{StaticResource InputBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="9,4"
                                            Margin="12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Hotkey}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                    </Border>
                                    <Button Grid.Column="3"
                                            Content="Запустить"
                                            Style="{StaticResource ActionButtonStyle}"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.RunBindCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Visibility="{Binding IsVariablesView, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Данные для подстановки"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}"/>
                        <TextBlock Text="Заполни значения один раз и используй их в шагах бинда."
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="600" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Позывной" VerticalAlignment="Center" Margin="0,4,12,12"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CallSign, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Text="Звание" VerticalAlignment="Center" Margin="0,4,12,12"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="2" Text="ФИО" VerticalAlignment="Center" Margin="0,4,12,12"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="3" Text="Подразделение" VerticalAlignment="Center" Margin="0,4,12,12"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="4" Text="Организация" VerticalAlignment="Center" Margin="0,4,12,12"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Organization, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <Border Grid.Row="5" Grid.ColumnSpan="2"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Переменные в шагах бинда"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextLightBrush}"/>
                                    <TextBlock Text="{}{позывной}   {звание}   {фио}   {имя}   {подразделение}   {организация}"
                                               FontFamily="Consolas"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="{}Пример: /me сотрудник {звание} {позывной} представился."
                                               FontSize="11"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsNotepadView, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}" Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Личные заметки"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextLightBrush}"
                               Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding NotepadContent, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Segoe UI"
                             FontSize="13"
                             Padding="10"/>
                </Grid>

                <Grid Visibility="{Binding IsDescriptionView, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}" Margin="20">
                    <StackPanel>
                        <TextBlock Text="Description"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="Version - 1.0.0"
                                   FontSize="14"
                                   Foreground="{StaticResource TextLightBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="By 1strh"
                                   FontSize="14"
                                   Foreground="{StaticResource TextLightBrush}"/>
                        <Image Source="/Assets/300px-Кот-Базилио.webp"
                               Width="300"
                               Height="300"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               Margin="0,20,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding IsSettingsView, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}" Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                            <TextBlock Text="Настройки"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLightBrush}"
                                       Margin="0,0,0,16"/>
                            <Label Content="Таймаут шага (секунды)"/>
                            <TextBox Text="{Binding StepTimeout, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,14"/>
                            <Label Content="Позиция оверлея"/>
                            <ComboBox SelectedValue="{Binding OverlayPosition}"
                                      SelectedValuePath="Tag"
                                      Margin="0,0,0,14">
                                <ComboBoxItem Content="Правый верх" Tag="top-right"/>
                                <ComboBoxItem Content="Левый верх" Tag="top-left"/>
                                <ComboBoxItem Content="Правый низ" Tag="bottom-right"/>
                                <ComboBoxItem Content="Левый низ" Tag="bottom-left"/>
                            </ComboBox>
                            <Label Content="Активный профиль биндов"/>
                            <ComboBox ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,14"/>
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                            <CheckBox Content="Звуковые сигналы"
                                      IsChecked="{Binding SoundNotifications}"
                                      Margin="0,0,0,10"/>
                            <Label Content="Звук уведомления"/>
                            <ComboBox SelectedValue="{Binding NotificationSound, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      Margin="0,0,0,14">
                                <ComboBoxItem Content="Уведомление VK" Tag="zvuk-soobsheniya-vk-1.mp3"/>
                                <ComboBoxItem Content="SMS-уведомление" Tag="zvuk-opovesheniya-sms.mp3"/>
                            </ComboBox>
                            <CheckBox Content="Автозапуск с Windows"
                                      IsChecked="{Binding AutoStart}"
                                      Margin="0,0,0,10"/>
                            <CheckBox Content="Сворачивать в трей при закрытии"
                                      IsChecked="{Binding MinimizeToTray}"
                                      Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsBindsView, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <Button Content="Добавить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AddBindCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Изменить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding EditBindCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Дублировать"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DuplicateBindCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Удалить"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteBindCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding HotkeyStatus}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"/>
                </Grid>
            </Border>

            <Grid Grid.RowSpan="3"
                  Visibility="{Binding IsBindEditorOpen, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"
                  Background="#99000000">
                <Border Margin="24"
                        Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="48"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,0">
                            <TextBlock Text="Редактор бинда"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLightBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,12">
                            <StackPanel>
                                <Label Content="Название"/>
                                <TextBox Text="{Binding BindEditor.BindName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <Label Content="Горячая клавиша"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource InputBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="10,6">
                                        <TextBlock Text="{Binding BindEditor.Hotkey}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <Button Grid.Column="1"
                                            Content="{Binding BindEditor.CaptureButtonText}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding BindEditor.ToggleCaptureCommand}"
                                            Margin="8,0,0,0"
                                            Width="180"/>
                                    <Button Grid.Column="2"
                                            Content="Сбросить"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding BindEditor.ResetHotkeyCommand}"
                                            Margin="6,0,0,0"/>
                                </Grid>
                                <CheckBox Content="Бинд включён"
                                          IsChecked="{Binding BindEditor.Enabled}"
                                          Margin="0,0,0,10"/>
                                <TextBlock Text="Текст отправляется по шагам: скопируй его в игре и нажми Enter."
                                           FontSize="11"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Label Content="Шаги"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Вверх" Style="{StaticResource IconButtonStyle}" Padding="7,3" Command="{Binding BindEditor.MoveUpCommand}" Margin="0,0,4,0"/>
                                        <Button Content="Вниз" Style="{StaticResource IconButtonStyle}" Padding="7,3" Command="{Binding BindEditor.MoveDownCommand}" Margin="0,0,4,0"/>
                                        <Button Content="Удалить шаг" Style="{StaticResource DangerButtonStyle}" Padding="7,3" Command="{Binding BindEditor.RemoveStepCommand}"/>
                                    </StackPanel>
                                </Grid>
                                <ListView ItemsSource="{Binding BindEditor.Steps}"
                                          SelectedItem="{Binding BindEditor.SelectedStep, Mode=TwoWay}"
                                          Background="{StaticResource InputBackgroundBrush}"
                                          Foreground="{StaticResource TextLightBrush}"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          BorderThickness="1"
                                          MinHeight="150"
                                          MaxHeight="260">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
                                            <Setter Property="Padding" Value="4,2"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PanelHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource TextLightBrush}"
                                                     Padding="2"/>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button Content="Добавить шаг"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BindEditor.AddStepCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding BindEditor.ValidationMessage}"
                                           Foreground="{StaticResource DangerBrush}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="14,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Отмена"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CancelBindEditCommand}"
                                        Width="90"
                                        Margin="0,0,8,0"/>
                                <Button Content="Сохранить"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveBindEditCommand}"
                                        Width="100"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.RowSpan="3"
                  Visibility="{Binding IsTabEditorOpen, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"
                  Background="#99000000">
                <Border Width="420"
                        Height="190"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="48"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="14,0">
                            <TextBlock Text="Название категории"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLightBrush}"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="16,12">
                            <Label Content="Название"/>
                            <TextBox Text="{Binding TabName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding TabValidationMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="14,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Отмена"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CancelTabEditCommand}"
                                        Width="85"
                                        Margin="0,0,8,0"/>
                                <Button Content="Сохранить"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveTabCommand}"
                                        Width="95"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
